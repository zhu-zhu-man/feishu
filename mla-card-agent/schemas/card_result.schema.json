{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mla.card_result.v1",
  "title": "Card Agent Output",
  "description": "Result of a card rendering and sending operation",
  "type": "object",
  "required": ["schema_version", "type", "status", "idempotency_key", "delivery", "artifacts", "warnings"],
  "properties": {
    "schema_version": { "const": "mla.card_result.v1" },
    "type": {
      "type": "string",
      "enum": ["pre_meeting_card_result", "post_meeting_card_result", "cancel_notice_card_result", "task_digest_card_result"]
    },
    "status": { "type": "string", "enum": ["sent", "partial", "error"] },
    "idempotency_key": { "type": "string" },
    "delivery": {
      "type": "object",
      "required": ["channel", "recipient_type", "as", "msg_type"],
      "properties": {
        "channel": { "const": "im" },
        "recipient_type": { "type": "string", "enum": ["user", "chat"] },
        "recipient_id": { "type": "string" },
        "as": { "type": "string", "enum": ["user", "bot"] },
        "msg_type": { "const": "interactive" },
        "message_id": { "type": "string" },
        "send_time": { "type": "string" }
      }
    },
    "artifacts": {
      "type": "object",
      "required": ["card_json_path", "send_raw_path"],
      "properties": {
        "card_json_path": { "type": "string" },
        "send_raw_path": { "type": "string" },
        "card_json_sha256": { "type": "string" },
        "send_raw_sha256": { "type": "string" }
      }
    },
    "error": {
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" }
      }
    },
    "warnings": { "type": "array" }
  }
}
