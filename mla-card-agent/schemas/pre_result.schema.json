{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mla.pre_result.v1",
  "title": "Pre Agent Output (Card Agent's read-only view)",
  "description": "Pre Agent output that Card Agent reads to render the card. Only the fields Card Agent needs.",
  "type": "object",
  "required": ["schema_version", "status", "meeting", "brief", "retrieval_trace"],
  "properties": {
    "schema_version": { "const": "mla.pre_result.v1" },
    "status": { "type": "string", "enum": ["ok", "partial", "error"] },
    "idempotency_key": { "type": "string" },
    "meeting": {
      "type": "object",
      "required": ["event_id", "summary"],
      "properties": {
        "event_id": { "type": "string" },
        "summary": { "type": "string" },
        "start_time": { "type": "string" },
        "end_time": { "type": "string" },
        "app_link": { "type": "string" },
        "vchat_url": { "type": "string" }
      }
    },
    "brief": {
      "type": "object",
      "properties": {
        "one_sentence_goal": { "type": "string" },
        "background_items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["text", "source"],
            "properties": {
              "text": { "type": "string" },
              "importance": { "type": "string" },
              "source": {
                "type": "object",
                "properties": {
                  "type": { "type": "string" },
                  "title": { "type": "string" },
                  "url": { "type": "string" }
                }
              }
            }
          }
        },
        "history_decisions": { "type": "array" },
        "open_risks": { "type": "array" },
        "suggested_agenda": { "type": "array", "items": { "type": "string" } },
        "related_links": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["title", "url", "type"],
            "properties": {
              "title": { "type": "string" },
              "url": { "type": "string" },
              "type": { "type": "string", "enum": ["calendar", "vc", "doc", "wiki", "minutes"] }
            }
          }
        }
      }
    },
    "retrieval_trace": {
      "type": "object",
      "properties": {
        "docs_searched": { "type": "integer" },
        "docs_read": { "type": "integer" },
        "catalog_hits": { "type": "integer" }
      }
    },
    "warnings": { "type": "array" }
  }
}
