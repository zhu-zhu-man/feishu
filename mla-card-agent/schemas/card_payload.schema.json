{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mla.card_payload.v1",
  "title": "Feishu Interactive Card Payload",
  "description": "The actual JSON sent to lark-cli im +messages-send --content",
  "type": "object",
  "required": ["config", "header", "elements"],
  "properties": {
    "config": {
      "type": "object",
      "properties": {
        "wide_screen_mode": { "type": "boolean" }
      }
    },
    "header": {
      "type": "object",
      "required": ["template", "title"],
      "properties": {
        "template": { "type": "string", "enum": ["blue", "green", "red", "yellow", "purple"] },
        "title": {
          "type": "object",
          "required": ["tag", "content"],
          "properties": {
            "tag": { "const": "plain_text" },
            "content": { "type": "string" }
          }
        }
      }
    },
    "elements": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
