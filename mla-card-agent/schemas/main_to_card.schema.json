{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mla.main_to_card.v1",
  "title": "Main Agent → Card Agent",
  "description": "Card rendering and delivery request from Main Agent",
  "type": "object",
  "required": ["schema_version", "route", "idempotency_key", "source", "recipient", "delivery", "meeting"],
  "properties": {
    "schema_version": { "const": "mla.main_to_card.v1" },
    "route": {
      "type": "string",
      "enum": ["send_pre_meeting_card", "send_post_meeting_card", "send_cancel_notice_card", "send_task_digest_card"]
    },
    "idempotency_key": { "type": "string" },
    "source": {
      "type": "object",
      "required": ["pre_result_path"],
      "properties": {
        "pre_result_path": { "type": "string", "description": "Path to Pre Agent's pre_result.json" },
        "post_result_path": { "type": "string", "description": "Path to Post Agent's post_result.json" }
      }
    },
    "recipient": {
      "type": "object",
      "required": ["type", "open_id"],
      "properties": {
        "type": { "type": "string", "enum": ["user", "chat"] },
        "open_id": { "type": "string" },
        "chat_id": { "type": "string" }
      }
    },
    "delivery": {
      "type": "object",
      "required": ["channel", "as", "msg_type"],
      "properties": {
        "channel": { "const": "im" },
        "as": { "type": "string", "enum": ["user", "bot"] },
        "msg_type": { "const": "interactive" }
      }
    },
    "meeting": {
      "type": "object",
      "required": ["event_id", "summary", "start_time"],
      "properties": {
        "event_id": { "type": "string" },
        "summary": { "type": "string" },
        "start_time": { "type": "string" },
        "end_time": { "type": "string" },
        "app_link": { "type": "string" },
        "vchat_url": { "type": "string" }
      }
    }
  }
}
