{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mla.main_to_card.v1",
  "title": "Main Agent → Card Agent",
  "type": "object",
  "required": ["schema_version", "card_type", "meeting", "reason", "idempotency_key"],
  "properties": {
    "schema_version": { "const": "mla.main_to_card.v1" },
    "card_type": { "type": "string", "enum": ["pre_brief", "post_summary", "cancel_notice", "meeting_changed"] },
    "meeting": {
      "type": "object",
      "required": ["event_id", "summary"],
      "properties": {
        "event_id": { "type": "string" },
        "summary": { "type": "string" },
        "start_time": { "type": "object" },
        "end_time": { "type": "object" },
        "app_link": { "type": "string" },
        "vchat_url": { "type": "string" },
        "organizer": { "type": "object" }
      }
    },
    "payload": { "type": "object", "description": "pre_result or post_result from Pre/Post Agent" },
    "recipient": {
      "type": "object",
      "properties": {
        "user_ids": { "type": "array", "items": { "type": "string" } },
        "chat_id": { "type": "string" }
      }
    },
    "reason": { "type": "string" },
    "idempotency_key": { "type": "string" }
  }
}
