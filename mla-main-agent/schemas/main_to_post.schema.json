{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mla.main_to_post.v1",
  "title": "Main Agent → Post Agent",
  "type": "object",
  "required": ["schema_version", "route", "meeting", "reason", "idempotency_key"],
  "properties": {
    "schema_version": { "const": "mla.main_to_post.v1" },
    "route": { "const": "post_meeting" },
    "meeting": {
      "type": "object",
      "required": ["event_id", "meeting_id", "summary", "start_time"],
      "properties": {
        "event_id": { "type": "string" },
        "meeting_id": { "type": "string", "description": "VC meeting ID from vc +search" },
        "summary": { "type": "string" },
        "start_time": {
          "type": "object",
          "required": ["datetime"],
          "properties": {
            "datetime": { "type": "string" },
            "timezone": { "type": "string" }
          }
        },
        "end_time": {
          "type": "object",
          "properties": {
            "datetime": { "type": "string" },
            "timezone": { "type": "string" }
          }
        },
        "app_link": { "type": "string", "description": "VC app link from vc +search meta_data" },
        "organizer": {
          "type": "object",
          "properties": {
            "display_name": { "type": "string" },
            "open_id": { "type": "string" }
          }
        }
      }
    },
    "reason": { "type": "string", "enum": ["ended", "retry"] },
    "idempotency_key": { "type": "string" },
    "raw_files": {
      "type": "object",
      "description": "Main Agent 预取的原始 CLI 结果路径。Post Agent 直接读取，不重复调用 CLI。",
      "properties": {
        "vc_search": { "type": "string" },
        "vc_notes": { "type": "string" },
        "note_doc": { "type": "string" },
        "verbatim_doc": { "type": "string" },
        "calendar": { "type": "string" }
      }
    }
  }
}
