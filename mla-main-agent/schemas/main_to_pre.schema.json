{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mla.main_to_pre.v1",
  "title": "Main Agent → Pre Agent — Pre-Meeting Retrieval Request",
  "description": "Main Agent 派发给 Pre Agent 的会前简报请求。meeting 数据来自 calendar +agenda 原始响应。workflow 字段定义 Pre Agent 必须执行的检索步骤。",
  "type": "object",
  "required": ["schema_version", "route", "meeting", "reason", "idempotency_key"],
  "properties": {
    "schema_version": { "const": "mla.main_to_pre.v1" },
    "route": { "const": "pre_meeting" },
    "workflow": {
      "type": "object",
      "description": "Pre Agent 必须执行的检索工作流定义",
      "required": ["name", "required_steps"],
      "properties": {
        "name": {
          "type": "string",
          "const": "pre_meeting_retrieval_and_brief"
        },
        "required_steps": {
          "type": "array",
          "description": "Pre Agent 必须按顺序执行的步骤。跳过任一步骤 = 无效输出。",
          "items": {
            "type": "string",
            "enum": [
              "validate_input",
              "extract_short_queries",
              "drive_search",
              "docs_search_fallback",
              "fetch_evidence",
              "generate_brief",
              "validate_output"
            ]
          },
          "minItems": 1
        },
        "min_retrieval_attempts": {
          "type": "object",
          "properties": {
            "drive_search": { "type": "integer", "default": 1 },
            "docs_search_fallback_if_empty": { "type": "integer", "default": 1 }
          }
        },
        "allow_calendar_only_fallback": {
          "type": "boolean",
          "default": true,
          "description": "无检索结果时是否允许仅用 calendar_description 生成简报"
        }
      }
    },
    "meeting": {
      "type": "object",
      "required": ["event_id", "summary", "start_time", "end_time", "vchat_url"],
      "properties": {
        "event_id": {
          "type": "string",
          "description": "来自 calendar +agenda 的 event_id 字段"
        },
        "summary": {
          "type": "string",
          "description": "会议标题，来自 calendar +agenda 的 summary 字段"
        },
        "start_time": {
          "type": "object",
          "required": ["datetime"],
          "properties": {
            "datetime": { "type": "string", "format": "date-time" },
            "timezone": { "type": "string" }
          },
          "description": "来自 calendar +agenda 的 start_time 对象（必须用 datetime 字段，禁止用纯字符串）"
        },
        "end_time": {
          "type": "object",
          "required": ["datetime"],
          "properties": {
            "datetime": { "type": "string", "format": "date-time" },
            "timezone": { "type": "string" }
          },
          "description": "来自 calendar +agenda 的 end_time 对象"
        },
        "app_link": {
          "type": "string",
          "description": "飞书日历事件链接，来自 calendar +agenda 的 app_link 字段"
        },
        "vchat_url": {
          "type": "string",
          "description": "视频会议链接，来自 calendar +agenda 的 vchat.meeting_url 字段（注意：必须用 vchat_url，禁止用 meeting_url）"
        },
        "description": {
          "type": "string",
          "description": "会议描述，来自 calendar +agenda 的 description 字段"
        },
        "organizer": {
          "type": "object",
          "required": ["display_name", "open_id"],
          "properties": {
            "display_name": {
              "type": "string",
              "description": "来自 calendar +agenda 的 event_organizer.display_name"
            },
            "open_id": {
              "type": "string",
              "description": "来自 calendar +agenda 的 event_organizer.user_id（注意：user_id 映射到 open_id）"
            }
          }
        },
        "status": {
          "type": "string",
          "enum": ["confirmed", "tentative", "cancelled"],
          "description": "会议状态，calendar +agenda 无此字段，Main Agent 默认设为 confirmed"
        }
      }
    },
    "reason": {
      "type": "string",
      "enum": ["new_meeting", "time_changed", "retry"],
      "description": "路由原因"
    },
    "idempotency_key": {
      "type": "string",
      "description": "幂等键，格式 mla-pre_meeting-<event_id_short>-<yyyymmdd>"
    }
  }
}
