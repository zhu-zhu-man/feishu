{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mla.dispatch_record.v1",
  "title": "Dispatch Record",
  "description": "Main Agent 派发子 Agent 的记录，保存在 var/state/dispatched.json",
  "type": "object",
  "required": ["idempotency_key", "route", "target_agent", "status", "created_at"],
  "properties": {
    "idempotency_key": { "type": "string" },
    "route": { "type": "string", "enum": ["pre_meeting", "post_meeting", "cancel_notice", "meeting_changed"] },
    "target_agent": { "type": "string", "enum": ["mla-pre-agent", "mla-post-agent", "mla-card-agent"] },
    "agent_id_requested": { "type": "string", "description": "sessions_spawn 时指定的 agentId，用于审计是否真的调用了目标 Agent" },
    "spawn_method": { "type": "string", "enum": ["sessions_spawn", "fallback_file"], "description": "派发方式" },
    "status": { "type": "string", "enum": ["spawned", "done", "failed", "skipped"] },
    "run_id": { "type": "string", "description": "sessions_spawn 返回的 runId" },
    "child_session_key": { "type": "string", "description": "子 Agent session key，用于关联日志" },
    "payload_hash": { "type": "string", "description": "派发 payload 的 SHA256，用于审计" },
    "result_summary": { "type": "string", "description": "子 Agent 返回结果的简要描述" },
    "created_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" }
  }
}
