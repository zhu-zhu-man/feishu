{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mla.pre_result.v1",
  "title": "Pre Agent Output",
  "type": "object",
  "required": ["schema_version", "type", "status", "idempotency_key", "meeting", "brief", "retrieval_trace", "warnings"],
  "properties": {
    "schema_version": { "const": "mla.pre_result.v1" },
    "type": { "const": "pre_meeting_brief" },
    "status": { "type": "string", "enum": ["ok", "partial", "error"] },
    "idempotency_key": { "type": "string" },
    "error_code": { "type": "string", "description": "Present only when status=error" },
    "meeting": {
      "type": "object",
      "required": ["event_id", "summary", "start_time"],
      "properties": {
        "event_id": { "type": "string" },
        "summary": { "type": "string" },
        "start_time": { "type": "string", "description": "ISO 8601" },
        "end_time": { "type": "string" },
        "app_link": { "type": "string" },
        "vchat_url": { "type": "string" }
      }
    },
    "brief": {
      "type": "object",
      "properties": {
        "one_sentence_goal": { "type": "string" },
        "background_items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["text", "source"],
            "properties": {
              "text": { "type": "string" },
              "importance": { "type": "string", "enum": ["high", "medium", "low"] },
              "source": {
                "type": "object",
                "required": ["type", "title"],
                "properties": {
                  "type": { "type": "string", "enum": ["doc", "wiki", "minutes", "calendar_description", "vc"] },
                  "title": { "type": "string" },
                  "url": { "type": "string" },
                  "token": { "type": "string" }
                }
              },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        },
        "history_decisions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["text", "source"],
            "properties": {
              "text": { "type": "string" },
              "source": {
                "type": "object",
                "required": ["type", "title"],
                "properties": {
                  "type": { "type": "string" },
                  "title": { "type": "string" },
                  "url": { "type": "string" },
                  "meeting_id": { "type": "string" }
                }
              },
              "confidence": { "type": "number" }
            }
          }
        },
        "open_risks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["text", "source"],
            "properties": {
              "text": { "type": "string" },
              "why_now": { "type": "string" },
              "source": {
                "type": "object",
                "required": ["type", "title"],
                "properties": {
                  "type": { "type": "string" },
                  "title": { "type": "string" },
                  "url": { "type": "string" }
                }
              },
              "confidence": { "type": "number" }
            }
          }
        },
        "suggested_agenda": {
          "type": "array", "items": { "type": "string" }
        },
        "related_links": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["title", "url", "type"],
            "properties": {
              "title": { "type": "string" },
              "url": { "type": "string" },
              "type": { "type": "string", "enum": ["calendar", "vc", "doc", "wiki", "minutes", "task"] }
            }
          }
        }
      }
    },
    "retrieval_trace": {
      "type": "object",
      "required": ["commands", "docs_searched"],
      "properties": {
        "keywords": { "type": "array", "items": { "type": "string" } },
        "catalog": {
          "type": "object",
          "description": "Local Doc Catalog usage trace",
          "properties": {
            "enabled": { "type": "boolean" },
            "index_path": { "type": "string" },
            "index_doc_count": { "type": "integer" },
            "index_updated_at": { "type": "string" },
            "candidates_found": { "type": "integer" },
            "top_matches": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "title": { "type": "string" },
                  "score": { "type": "number" },
                  "match_reasons": { "type": "array", "items": { "type": "string" } }
                }
              }
            }
          }
        },
        "commands": {
          "type": "array",
          "description": "每条实际执行的 CLI 命令的收据。没有 commands 的 retrieval_trace 是无效的。",
          "items": {
            "type": "object",
            "required": ["name", "argv", "raw_path", "raw_sha256", "result_count"],
            "properties": {
              "name": {
                "type": "string",
                "enum": ["drive_search", "docs_search", "docs_fetch", "vc_search", "vc_notes"]
              },
              "argv": {
                "type": "array",
                "items": { "type": "string" },
                "description": "Full command argv for reproducibility"
              },
              "raw_path": { "type": "string", "description": "raw 文件路径" },
              "raw_sha256": { "type": "string", "description": "raw 文件的 SHA256 hash" },
              "exit_code": { "type": "integer" },
              "status": { "type": "string", "enum": ["ok", "empty", "error"] },
              "result_count": { "type": "integer", "description": "实际返回条数" }
            }
          }
        },
        "docs_searched": { "type": "integer", "description": "所有 drive_search + docs_search 返回条数之和" },
        "docs_read": { "type": "integer", "description": "docs +fetch 调用次数" },
        "meetings_searched": { "type": "integer", "description": "vc +search 返回条数之和" },
        "minutes_read": { "type": "integer", "description": "会议纪要读取次数" },
        "catalog_hits": { "type": "integer", "description": "本地 catalog 命中数" }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" }
        }
      }
    }
  }
}
