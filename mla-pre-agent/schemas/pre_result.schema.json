{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mla.pre_result.v1",
  "title": "Pre Agent Output",
  "type": "object",
  "required": ["schema_version", "type", "status", "idempotency_key", "meeting", "brief", "retrieval_trace", "warnings"],
  "properties": {
    "schema_version": { "const": "mla.pre_result.v1" },
    "type": { "const": "pre_meeting_brief" },
    "status": { "type": "string", "enum": ["ok", "partial", "error"] },
    "idempotency_key": { "type": "string" },
    "error_code": { "type": "string", "description": "Present only when status=error" },
    "meeting": {
      "type": "object",
      "required": ["event_id", "summary", "start_time"],
      "properties": {
        "event_id": { "type": "string" },
        "summary": { "type": "string" },
        "start_time": { "type": "string", "description": "ISO 8601" },
        "end_time": { "type": "string" },
        "app_link": { "type": "string" },
        "vchat_url": { "type": "string" }
      }
    },
    "brief": {
      "type": "object",
      "properties": {
        "one_sentence_goal": { "type": "string" },
        "background_items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["text", "source"],
            "properties": {
              "text": { "type": "string" },
              "importance": { "type": "string", "enum": ["high", "medium", "low"] },
              "source": {
                "type": "object",
                "required": ["type", "title"],
                "properties": {
                  "type": { "type": "string", "enum": ["doc", "wiki", "minutes", "calendar_description", "vc"] },
                  "title": { "type": "string" },
                  "url": { "type": "string" },
                  "token": { "type": "string" }
                }
              },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        },
        "history_decisions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["text", "source"],
            "properties": {
              "text": { "type": "string" },
              "source": {
                "type": "object",
                "required": ["type", "title"],
                "properties": {
                  "type": { "type": "string" },
                  "title": { "type": "string" },
                  "url": { "type": "string" },
                  "meeting_id": { "type": "string" }
                }
              },
              "confidence": { "type": "number" }
            }
          }
        },
        "open_risks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["text", "source"],
            "properties": {
              "text": { "type": "string" },
              "why_now": { "type": "string" },
              "source": {
                "type": "object",
                "required": ["type", "title"],
                "properties": {
                  "type": { "type": "string" },
                  "title": { "type": "string" },
                  "url": { "type": "string" }
                }
              },
              "confidence": { "type": "number" }
            }
          }
        },
        "suggested_agenda": {
          "type": "array", "items": { "type": "string" }
        },
        "related_links": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["title", "url", "type"],
            "properties": {
              "title": { "type": "string" },
              "url": { "type": "string" },
              "type": { "type": "string", "enum": ["calendar", "vc", "doc", "wiki", "minutes", "task"] }
            }
          }
        }
      }
    },
    "retrieval_trace": {
      "type": "object",
      "properties": {
        "keywords": { "type": "array", "items": { "type": "string" } },
        "docs_searched": { "type": "integer" },
        "docs_read": { "type": "integer" },
        "meetings_searched": { "type": "integer" },
        "minutes_read": { "type": "integer" }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" }
        }
      }
    }
  }
}
